---
import { Icon } from 'astro-icon/components';
import SectionHeader from '~/components/SectionHeader.astro';
import { artcraftUrl, craftingApps } from '~/data/content';
---

<section id="apps" class="shell py-24 md:py-32">
  <div data-reveal>
    <SectionHeader
      title="Crafting 应用系列"
      standfirst="WordCraft 是 Crafting 应用系列的一员。这些工具由 ArtCraft 团队出品，免费、开源，每一款都用 Rust 从零写就，且都能独立运行。"
    />
  </div>

  <ul class="mt-16 divide-y divide-line border-t-2 border-ink" data-reveal>
    {
      craftingApps.map((app, index) => (
        <li
          class:list={[
            'group -mx-3 grid grid-cols-[2.75rem_1fr] items-baseline gap-x-5 gap-y-2 rounded-card px-3 py-4.5 transition-all duration-200 md:grid-cols-[2.75rem_12.5rem_1fr_6.5rem]',
            app.current
              ? 'border border-accent/25 bg-accent/10 shadow-sm'
              : 'hover:bg-raised/70',
          ]}
          style={`--reveal-delay: ${(index % 4) * 60}ms`}
        >
          <img
            src={app.icon}
            alt=""
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
            class="h-9 w-9 self-center rounded-lg shadow-sm transition-transform duration-200 group-hover:scale-105"
          />
          <div class="flex flex-wrap items-center gap-2 self-center">
            <h3 class="text-[16px] font-semibold tracking-tight text-ink">
              <a
                href={app.site}
                target="_blank"
                rel="noreferrer noopener"
                class="transition-colors duration-200 hover:text-accent"
              >
                {app.name}
              </a>
            </h3>
            {app.current ? (
              <span class="rounded-full bg-accent/20 px-2 py-0.5 text-[11px] font-medium text-accent">
                当前应用
              </span>
            ) : null}
          </div>
          <p class="col-start-2 text-[14.5px] leading-[1.7] text-ink-soft md:col-start-auto">
            {app.duty}
          </p>
          <a
            href={app.repo}
            target="_blank"
            rel="noreferrer noopener"
            class="folio col-start-2 inline-flex items-center gap-1.5 transition-all duration-200 group-hover:translate-x-0.5 group-hover:text-accent md:col-start-auto md:justify-self-end"
          >
            GitHub
            <Icon name="ph:arrow-square-out" class="h-3.5 w-3.5" aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ul>

  <p class="mt-10 max-w-[62ch] text-[15.5px] leading-[1.9] text-ink-soft" data-reveal>
    以及{' '}
    <a
      href={artcraftUrl}
      class="text-ink underline underline-offset-4 transition-colors hover:text-accent"
      target="_blank"
      rel="noreferrer noopener">ArtCraft</a
    >
    本身，面向想要真正掌控权的艺术家的 AI 图像与视频工作室。
  </p>
</section>