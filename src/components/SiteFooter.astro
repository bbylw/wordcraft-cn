---
import { Icon } from 'astro-icon/components';
import { discordUrl, repoUrl } from '~/data/content';

const doc = (path: string) => `${repoUrl}/blob/main/${path}`;
---

<footer class="border-t-2 border-ink bg-surface/40">
  <div class="shell">
    <div class="flex flex-col justify-between gap-8 py-12 md:flex-row md:items-center">
      <div>
        <a href="/" class="flex items-center gap-2.5" aria-label="WordCraft 首页">
          <img src="/images/brand/artcraft-mark.svg" alt="" width="26" height="26" class="h-6.5 w-6.5" />
          <span class="serif text-[19px] font-semibold tracking-tight text-ink">WordCraft</span>
        </a>
        <p class="mt-3 max-w-[46ch] text-[15px] leading-relaxed text-ink-soft">
          写作与文档排版。一款开源、以净室方式重新实现的文字处理器，完全用 Rust 重写。
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href={repoUrl}
          class="btn btn-ghost h-10 px-4 text-sm"
          target="_blank"
          rel="noreferrer noopener"
        >
          <Icon name="ph:github-logo" class="h-4.25 w-4.25" aria-hidden="true" />
          GitHub 源码
        </a>
        <a
          href={discordUrl}
          class="btn btn-primary h-10 px-4 text-sm"
          target="_blank"
          rel="noreferrer noopener"
        >
          <Icon name="ph:chat-circle-dots" class="h-4.25 w-4.25" aria-hidden="true" />
          加入 Discord
        </a>
      </div>
    </div>

    <div class="grid gap-x-12 gap-y-6 border-t border-line py-8 text-[13.5px] text-ink-mute md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="folio text-ink-mute">版权与许可</p>
        <p class="mt-2 leading-relaxed">
          双重许可，任选
          <a href={doc('LICENSE-MIT')} class="text-ink-soft underline underline-offset-4 transition-colors hover:text-accent" target="_blank" rel="noreferrer noopener">MIT</a>
          或
          <a href={doc('LICENSE-APACHE')} class="text-ink-soft underline underline-offset-4 transition-colors hover:text-accent" target="_blank" rel="noreferrer noopener">Apache-2.0</a>。版权所有 © 2026 ArtCraft 团队与 WordCraft 贡献者。
        </p>
      </div>
      <div class="md:col-span-7">
        <p class="folio text-ink-mute">商标声明</p>
        <p class="mt-2 leading-relaxed">
          Microsoft 与 Microsoft Word 是微软集团公司的商标。WordCraft 是一个独立的开源项目，与微软公司无隶属、赞助或背书关系；提及这些名称仅用于描述其所兼容的工作流。
        </p>
      </div>
    </div>
  </div>
</footer>