---
import { Icon } from 'astro-icon/components';
import SectionHeader from '~/components/SectionHeader.astro';
import { tourShots } from '~/data/content';
---

<section id="tour" class="shell scroll-mt-28 py-24 md:py-32">
  <div data-reveal>
    <SectionHeader
      title="功能一览"
      standfirst="下面每一张截图都是 WordCraft 本身，由它自带的 UI 测试工具在屏幕外渲染而成。"
    />
  </div>

  <div class="mt-16 grid grid-cols-1 gap-x-10 gap-y-14 md:grid-cols-12">
    {
      tourShots.map((shot, index) => (
        <figure class={shot.span} data-reveal style={`--reveal-delay: ${(index % 2) * 90}ms`}>
          <a
            href={shot.src}
            target="_blank"
            rel="noreferrer noopener"
            class="group block overflow-hidden rounded-card border border-line bg-surface shadow-md ring-1 ring-black/5 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl dark:ring-white/10"
          >
            <div class="overflow-hidden">
              <img
                src={shot.src}
                alt={shot.alt}
                width="1600"
                height="1000"
                loading="lazy"
                decoding="async"
                class="block aspect-16/10 w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.025]"
              />
            </div>
          </a>
          <figcaption class="mt-3.5 border-t border-line pt-3">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="folio shrink-0 font-medium text-ink">{shot.caption}</span>
              <span class="text-[14px] leading-relaxed text-ink-soft">{shot.detail}</span>
              <a
                href={shot.src}
                target="_blank"
                rel="noreferrer noopener"
                class="ml-auto inline-flex items-center gap-1 text-[13px] text-ink-mute transition-colors duration-200 hover:text-accent"
                aria-label={`查看原图：${shot.caption}`}
              >
                <span>原图</span>
                <Icon name="ph:arrow-square-out" class="h-3.5 w-3.5" aria-hidden="true" />
              </a>
            </div>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>