---
import { reasons } from '~/data/content';

const stats = [
  { value: '1.4', unit: '毫秒', label: '在 188 页文档中输入时，一次重新排版的耗时' },
  { value: '422', unit: '个命令', label: '同一套命令驱动功能区、快捷键、命令行工具与 MCP 服务器' },
];
---

<section id="why" class="border-y border-line bg-surface py-24 md:py-32">
  <div class="shell">
    <div data-reveal>
      <div class="max-w-216">
        <span class="sigil" aria-hidden="true"></span>
        <h2 class="mt-5 text-[2rem] font-medium leading-[1.16] tracking-tight text-ink md:text-[2.375rem]">
          为何选择 WordCraft
        </h2>
        <p class="dropcap mt-6 max-w-[62ch] text-[17.5px] leading-[1.85] text-ink-soft">
          净室实现意味着你没有三十年 Word 肌肉记忆要丢掉，也不需要为了速度牺牲文件的可编辑性。既然这是一款排版工具，这一页也按排版的规矩来做。
        </p>
      </div>
    </div>

    <div class="mt-16 grid gap-x-12 gap-y-14 md:grid-cols-12">
      <div class="space-y-6 md:col-span-4">
        {
          stats.map((stat, index) => (
            <div
              data-reveal
              style={`--reveal-delay: ${index * 90}ms`}
              class="surface-card relative overflow-hidden p-6 sm:p-7"
            >
              <div class="pointer-events-none absolute -bottom-6 -right-6 h-24 w-24 rounded-full bg-accent/10 blur-xl" aria-hidden="true"></div>
              <p class="flex items-baseline gap-2 text-accent-strong dark:text-accent">
                <span class="serif tabular text-[3.75rem] font-semibold leading-none tracking-tight">
                  {stat.value}
                </span>
                <span class="text-[17px] font-medium text-ink-soft">{stat.unit}</span>
              </p>
              <p class="mt-3.5 text-[14.5px] leading-relaxed text-ink-soft">{stat.label}</p>
            </div>
          ))
        }
      </div>

      <ul class="space-y-5 md:col-span-8">
        {
          reasons.map((reason, index) => (
            <li
              class="group relative rounded-r-card border-l-[3px] border-accent/60 bg-linear-to-r from-accent/4 to-transparent py-4 pl-6 pr-4 transition-all duration-200 hover:border-accent hover:from-accent/9 sm:grid sm:grid-cols-[6.5rem_1fr] sm:gap-x-8 sm:gap-y-2"
              data-reveal
              style={`--reveal-delay: ${(index % 2) * 80}ms`}
            >
              <h3 class="whitespace-nowrap text-[16px] font-semibold text-ink transition-colors duration-200 group-hover:text-accent">{reason.title}</h3>
              <p class="text-[15.5px] leading-[1.8] text-ink-soft">{reason.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>