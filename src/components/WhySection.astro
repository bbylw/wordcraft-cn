---
import { reasons } from '~/data/content';

const stats = [
  { value: '1.4', unit: '毫秒', label: '在 188 页文档中输入时，一次重新排版的耗时' },
  { value: '422', unit: '个命令', label: '同一套命令驱动功能区、快捷键、命令行工具与 MCP 服务器' },
];
---

<section id="why" class="border-y border-line bg-surface py-24 md:py-32">
  <div class="shell">
    <div data-reveal>
      <div class="max-w-[54rem]">
        <span class="sigil" aria-hidden="true"></span>
        <h2 class="mt-5 text-[2rem] font-medium leading-[1.16] tracking-tight text-ink md:text-[2.375rem]">
          为何选择 WordCraft
        </h2>
        <p class="dropcap mt-6 max-w-[62ch] text-[17.5px] leading-[1.85] text-ink-soft">
          净室实现意味着你没有三十年 Word 肌肉记忆要丢掉，也不需要为了速度牺牲文件的可编辑性。既然这是一款排版工具，这一页也按排版的规矩来做。
        </p>
      </div>
    </div>

    <div class="mt-16 grid gap-x-12 gap-y-14 md:grid-cols-12">
      <div class="space-y-12 md:col-span-4">
        {
          stats.map((stat, index) => (
            <div data-reveal style={`--reveal-delay: ${index * 90}ms`}>
              <p class="flex items-baseline gap-2 text-accent-strong dark:text-accent">
                <span class="serif tabular text-[4rem] font-semibold leading-none tracking-tight">
                  {stat.value}
                </span>
                <span class="text-[17px] font-medium text-ink-soft">{stat.unit}</span>
              </p>
              <p class="mt-3.5 max-w-[30ch] text-[15px] leading-relaxed text-ink-soft">{stat.label}</p>
            </div>
          ))
        }
      </div>

      <ul class="space-y-9 md:col-span-8">
        {
          reasons.map((reason, index) => (
            <li
              class="grid gap-x-8 gap-y-2 border-l-2 border-accent pl-6 sm:grid-cols-[6.5rem_1fr]"
              data-reveal
              style={`--reveal-delay: ${(index % 2) * 80}ms`}
            >
              <h3 class="whitespace-nowrap text-[16.5px] font-semibold text-ink">{reason.title}</h3>
              <p class="text-[16px] leading-[1.8] text-ink-soft">{reason.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>